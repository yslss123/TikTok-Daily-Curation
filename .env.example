# Copy to .env. Never commit real credentials.
# TikTok Research API: only works for an approved Research API project.
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# Optional OpenAI-compatible text metadata classifier.
# If AI_API_KEY is empty, deterministic keyword classification is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
